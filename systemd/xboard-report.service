[Unit]
Description=Report sing-box AnyReality user traffic to XBoard
After=network-online.target docker.service xboard-sync.service
Wants=network-online.target docker.service
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/sing-box-sync
ExecStart=/usr/bin/python3 /opt/sing-box-sync/xboard_report.py loop
Restart=always
RestartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/sing-box-sync /opt/sing-box/logs

[Install]
WantedBy=multi-user.target
