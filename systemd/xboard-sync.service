[Unit]
Description=XBoard to sing-box AnyReality config sync
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/sing-box-sync
ExecStart=/usr/bin/python3 /opt/sing-box-sync/xboard_sync.py
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
